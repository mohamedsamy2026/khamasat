# Local development only. Replace placeholders and never commit the filled .env.
NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/athlete_ai_local"

# Generate a NEW application signing secret for the destination environment.
# Example: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
MANUS_JWT_SECRET=""

# Manus integration values must come from the authorized project environment.
# Anonymous demo access does not create a Manus account.
MANUS_PROJECT_ID=""
MANUS_OAUTH_API_URL=""
MANUS_OAUTH_PORTAL_URL=""
MANUS_API_URL=""
MANUS_API_KEY=""
MANUS_API_BROWSER_KEY=""
OWNER_OPEN_ID=""
